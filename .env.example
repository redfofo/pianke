# Required on FIRST startup only: choose a unique password (10–128 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set true behind an HTTPS reverse proxy; keep false for local HTTP development.
SESSION_COOKIE_SECURE=false
# Optional initial trusted Happy Capy root URL (http://host:port or https://host).
# Leave empty to configure from Settings. Saved data/config.json takes precedence.
CAPY_BACKEND_URL=
# Local persistence directory; Docker Compose uses its named volume at /app/data.
DATA_DIR=./data
PORT=8789
PLAYER_PORT=8789
# Optional bind address for Compose. Empty preserves publishing on all interfaces.
# Set 127.0.0.1 for a same-host reverse proxy; a container/remote proxy needs a reachable interface.
PLAYER_BIND_ADDRESS=
# Public browser/Emby URL advertised by UDP discovery. Set this when Docker hostname is not reachable on your LAN.
PUBLIC_BASE_URL=
# UDP port used by Emby-compatible clients for LAN discovery.
EMBY_DISCOVERY_PORT=7359
TRANSCODE_MAX_SESSIONS=1
# Software H.264 is portable. Hardware options: h264_qsv, h264_nvenc, h264_vaapi (requires matching device mapping).
TRANSCODE_VIDEO_CODEC=libx264
TRANSCODE_PRESET=veryfast
WIDGET_TIMEOUT_MS=120000
# Background catalog extraction stores detail metadata in SQLite and preloads poster bytes.
CATALOG_SYNC_INTERVAL_MINUTES=360
CATALOG_SYNC_MAX_PAGES=100
CATALOG_DETAIL_CACHE_DAYS=7
CATALOG_DETAIL_CONCURRENCY=3
# Persistent poster cache under DATA_DIR/posters.
POSTER_CACHE_MAX_MB=2048
POSTER_CACHE_MAX_AGE_DAYS=90
# Optional for networks using fake-IP DNS; keep empty with ordinary DNS.
UPSTREAM_DOH_URL=
# Optional fake-IP range of the local DNS gateway (Clash/mihomo/sing-box), e.g. 198.18.0.0/15.
# The gateway then decides each upstream connection's real destination; trust it only on your own network.
TRUSTED_FAKE_IP_CIDRS=
